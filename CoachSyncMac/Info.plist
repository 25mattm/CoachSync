<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Release builds: set COACHSYNC_BACKEND_URL in Config/Local.xcconfig. Debug builds use localhost. -->
	<key>CoachSyncBackendURL</key>
	<string>$(COACHSYNC_BACKEND_URL)</string>
	<key>CoachSyncPrivacyPolicyURL</key>
	<string>$(COACHSYNC_PRIVACY_POLICY_URL)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
