<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.coachsync</groupId>
    <artifactId>coachsync-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>coachsync-backend</name>
    <description>CoachSync backend — training-log vertical (entities, enums, repositories)</description>

    <properties>
        <!-- Spec mandates Java 21; the toolchain JDK (25) compiles to release 21. -->
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Auth: protects /api/** as a JWT resource server, and transitively pulls in
             Spring Security + Nimbus (oauth2-jose) — the JwtDecoder/JwtEncoder we use to
             verify Apple identity tokens (JWKS) and to issue/verify our own HS256 tokens. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <!-- Health endpoint only (see management.* in application.properties). The DataSource
             health indicator it auto-registers is the whole point: it turns "the database is gone"
             into a 503 an uptime check can see, rather than a startup crash nobody notices. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- OpenAPI 3 spec + Swagger UI (/v3/api-docs, /swagger-ui.html). 2.8.x is the latest
             GA; it advertises Spring Boot 3 / Framework 6 but works on Boot 4.1 (verified by
             OpenApiDocsTest). No springdoc 3.x exists yet. Explicit version — not BOM-managed. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.6</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring Boot 4 split the test slices into per-module artifacts;
             MockMvc web tests (@AutoConfigureMockMvc) live here. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- @WithMockUser + the jwt() MockMvc request post-processor for the locked API. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- In-memory DB so the Spring context + JPA mappings validate offline (no MySQL needed). -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
