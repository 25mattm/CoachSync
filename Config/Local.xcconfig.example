// Copy to Config/Local.xcconfig (gitignored) and fill in your own values. They override
// Config/Shared.xcconfig for every target and configuration. Keep this file out of commits.

COACHSYNC_BUNDLE_ID_PREFIX = com.yourname
COACHSYNC_DEVELOPMENT_TEAM = ABCDE12345
// "//" starts a comment in an xcconfig, hence the $() between the slashes.
COACHSYNC_BACKEND_URL = https:/$()/coachsync.example.com
